# Copy to .env. Defaults work for local development.
ENV=development
# DATABASE_URL=sqlite:///./jee_dev.db
# JWT_SECRET=<32+ random characters in production>
# Free OpenRouter models transcribe paper images and write mock variants (no paid calls are made).
OPENROUTER_API_KEY=
# Local LM Studio server, the third vote when answers need model agreement.
# LOCAL_LLM_URL=http://localhost:1234/v1/chat/completions
# Shared admin console with NEET Compass: the NEET | JEE switcher goes to NEET_URL/admin. Set the same random
# ADMIN_BRIDGE_SECRET (32+ characters) on both sites to arrive signed in (same-email admin account on both sites).
NEET_URL=http://localhost:8765
ADMIN_BRIDGE_SECRET=
